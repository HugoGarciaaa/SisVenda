<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisvenda.Views.VendaListPage"
             Title="Vendas"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="auto,*" Padding="0">
        <Grid ColumnDefinitions="*,auto" Padding="10" BackgroundColor="#2a2a2a" ColumnSpacing="10">
            <SearchBar Grid.Column="0"
                      x:Name="SearchBar" 
                      Placeholder="Buscar vendas..." 
                      PlaceholderColor="#808080"
                      TextChanged="OnSearchTextChanged"
                      BackgroundColor="#404040"
                      TextColor="White"/>
            <Button Grid.Column="1" 
                   Text="+" 
                   FontSize="24"
                   Clicked="OnAddVendaClicked"
                   CornerRadius="8"
                   WidthRequest="50"
                   HeightRequest="50"
                   BackgroundColor="#007AFF"
                   TextColor="White"
                   Padding="0"/>
        </Grid>

        <CollectionView Grid.Row="1" 
                       x:Name="VendaCollectionView"
                       ItemsSource="{Binding Vendas}"
                       SelectionMode="Single"
                       BackgroundColor="#1a1a1a">
            <CollectionView.ItemTemplate>
               <DataTemplate>
                   <StackLayout Padding="10" Margin="10" Spacing="0">
                       <Frame Padding="10" CornerRadius="10" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                           <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto" Padding="10" ColumnSpacing="10">

                           <Label Grid.Column="0" Grid.Row="0" 
                                 Text="{Binding Data, StringFormat='Data: {0:dd/MM/yyyy}'}" 
                                 FontSize="13" 
                                 FontAttributes="Bold"
                                 TextColor="White"/>

                           <Label Grid.Column="0" Grid.Row="1" 
                                 Text="{Binding Cliente.Nome, StringFormat='Cliente: {0}'}" 
                                 FontSize="12" 
                                 TextColor="#A0A0A0"/>

                           <Label Grid.Column="0" Grid.Row="2" 
                                 Text="{Binding ValorTotal, StringFormat='Total: R$ {0:F2}'}" 
                                 FontSize="12" 
                                 FontAttributes="Bold"
                                 TextColor="#34C759"/>

                           <Button Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                  Text="..." 
                                  FontSize="18"
                                  Clicked="OnOptionClicked"
                                  CornerRadius="8"
                                  WidthRequest="50"
                                  HeightRequest="50"
                                  BackgroundColor="#404040"
                                  TextColor="White"
                                  CommandParameter="{Binding .}"/>
                           </Grid>
                       </Frame>
                   </StackLayout>
               </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
