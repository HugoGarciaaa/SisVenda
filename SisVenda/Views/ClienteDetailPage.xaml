<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisvenda.Views.ClienteDetailPage"
             Title="Detalhes do Cliente"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="*,auto" Padding="0">
        <ScrollView Grid.Row="0" BackgroundColor="#1a1a1a">
            <VerticalStackLayout Padding="20" Spacing="20">

                <VerticalStackLayout Spacing="8">
                    <Label Text="Nome:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o nome do cliente"
                              Text="{Binding Cliente.Nome}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Email:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o email do cliente"
                              Text="{Binding Cliente.Email}"
                              Keyboard="Email"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Telefone:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o telefone do cliente"
                              Text="{Binding Cliente.Telefone}"
                              Keyboard="Telephone"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Endereco:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o endereco do cliente"
                              Text="{Binding Cliente.Endereco}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="CPF/CNPJ:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o CPF ou CNPJ"
                              Text="{Binding Cliente.CpfCnpj}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="10" ColumnSpacing="10" BackgroundColor="#2a2a2a">
            <Button Grid.Column="0"
                   Text="Cancelar"
                   Clicked="OnCancelClicked"
                   BackgroundColor="#FF3B30"
                   TextColor="White"
                   CornerRadius="8"
                   Padding="15"/>

            <Button Grid.Column="1"
                   Text="Salvar"
                   Clicked="OnSaveClicked"
                   BackgroundColor="#34C759"
                   TextColor="White"
                   CornerRadius="8"
                   Padding="15"/>
        </Grid>
    </Grid>
</ContentPage>
