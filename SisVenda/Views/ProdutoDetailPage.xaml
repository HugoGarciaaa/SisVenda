<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisvenda.Views.ProdutoDetailPage"
             Title="Detalhes do Produto"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="*,auto" Padding="0">
        <ScrollView Grid.Row="0" BackgroundColor="#1a1a1a">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Imagem do Produto -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Imagem do Produto:" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                    <Frame Padding="10" CornerRadius="10" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Image Source="{Binding Produto.ImagemUrl, FallbackValue='https://via.placeholder.com/300'}" 
                              Aspect="AspectFit"
                              HeightRequest="300"
                              BackgroundColor="#0a0a0a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Código -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Código:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o código do produto"
                              Text="{Binding Produto.Codigo}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Descrição -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Descrição:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Editor Placeholder="Digite a descrição do produto"
                           Text="{Binding Produto.Descricao}"
                           PlaceholderColor="#606060"
                           TextColor="White"
                           BackgroundColor="#2a2a2a"
                           HeightRequest="100"/>
                </VerticalStackLayout>

                <!-- Valor (Preço) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Valor:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="0.00"
                              Text="{Binding Produto.Preco}"
                              Keyboard="Numeric"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Custo -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Custo:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="0.00"
                              Text="{Binding Produto.PrecoCusto}"
                              Keyboard="Numeric"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- URL da Imagem (campo opcional para edição) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="URL da Imagem:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="https://exemplo.com/imagem.jpg"
                              Text="{Binding Produto.ImagemUrl}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Nome -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nome:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite o nome do produto"
                              Text="{Binding Produto.Nome}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Categoria -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categoria:" FontSize="12" FontAttributes="Bold" TextColor="#A0A0A0"/>
                    <Frame Padding="0" CornerRadius="8" BorderColor="#404040" HasShadow="False" BackgroundColor="#2a2a2a">
                        <Entry Placeholder="Digite a categoria do produto"
                              Text="{Binding Produto.Categoria}"
                              PlaceholderColor="#606060"
                              TextColor="White"
                              BackgroundColor="#2a2a2a"/>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="10" ColumnSpacing="10" BackgroundColor="#2a2a2a">
            <Button Grid.Column="0"
                   Text="Cancelar"
                   Clicked="OnCancelarClicked"
                   BackgroundColor="#FF3B30"
                   TextColor="White"
                   CornerRadius="8"
                   Padding="15"/>

            <Button Grid.Column="1"
                   Text="Salvar"
                   Clicked="OnSalvarClicked"
                   BackgroundColor="#34C759"
                   TextColor="White"
                   CornerRadius="8"
                   Padding="15"/>
        </Grid>
    </Grid>
</ContentPage>
