<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisvenda.MainPage"
             Title="SisVenda"
             BackgroundColor="#1a1a1a">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="20" VerticalOptions="CenterAndExpand">

            <Frame Padding="20" CornerRadius="20" BorderColor="Transparent" HasShadow="False" BackgroundColor="#2a2a2a">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Image Source="sisvenda_logo.svg" 
                          WidthRequest="200" 
                          HeightRequest="100" 
                          Aspect="AspectFit"
                          HorizontalOptions="Center"/>

                    <Label Text="SisVenda" 
                          FontSize="36" 
                          FontAttributes="Bold"
                          TextColor="#00D9FF"
                          HorizontalTextAlignment="Center"
                          Margin="0,10,0,0"/>

                    <Label Text="Gerenciamento de Vendas" 
                          FontSize="16" 
                          TextColor="#A0A0A0"
                          HorizontalTextAlignment="Center"
                          Margin="0,0,0,20"/>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="15">
                <Button Text="Produtos" 
                       Clicked="OnProdutosClicked"
                       BackgroundColor="#007AFF"
                       TextColor="White"
                       FontSize="16"
                       Padding="15"
                       CornerRadius="10"/>

                <Button Text="Clientes" 
                       Clicked="OnClientesClicked"
                       BackgroundColor="#007AFF"
                       TextColor="White"
                       FontSize="16"
                       Padding="15"
                       CornerRadius="10"/>

                <Button Text="Vendas" 
                       Clicked="OnVendasClicked"
                       BackgroundColor="#007AFF"
                       TextColor="White"
                       FontSize="16"
                       Padding="15"
                       CornerRadius="10"/>
            </VerticalStackLayout>

            <Label Text="Versao 1.0.0" 
                  FontSize="12" 
                  TextColor="#606060"
                  HorizontalTextAlignment="Center"
                  Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
